{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Urban Traffic",
            "type": "shell",
            "command": "${workspaceFolder}\\urban_traffic.exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "Path": "C:\\msys64\\ucrt64\\bin;${env:Path}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}\\build",
                "-G",
                "MinGW Makefiles"
            ],
            "options": {
                "env": {
                    "Path": "C:\\msys64\\ucrt64\\bin;${env:Path}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}\\build",
                "--config",
                "Release"
            ],
            "options": {
                "env": {
                    "Path": "C:\\msys64\\ucrt64\\bin;${env:Path}"
                }
            },
            "dependsOn": "CMake: configure",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
